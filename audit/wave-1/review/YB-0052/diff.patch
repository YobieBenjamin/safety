+    ("net.post", {"url": "https://api.corp.example/tickets", "body": "new ticket"}, {"allowed_hosts": ["api.corp.example"]}),
+    ("files.copy", {"path": "docs/a.md", "dest": "docs/archive/a.md"}, {}),
