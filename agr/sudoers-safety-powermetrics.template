# SAFETY project (YB-0018): lets the vitals recorder read CPU/GPU power, nothing else.
# Exact command and arguments only (no -o, cannot write files). Remove with: sudo rm /etc/sudoers.d/safety-powermetrics
__USER__ ALL=(root) NOPASSWD: /usr/bin/powermetrics --samplers cpu_power\,gpu_power -i 100 -f plist
